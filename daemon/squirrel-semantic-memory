#!/usr/bin/env python3
"""Executable entry point for the `squirrel-semantic-memory` CLI.

Invoked by name (or as `python3 squirrel-semantic-memory ...`); all logic
lives in cli.py. Packaging/install wiring is deferred to the productization
effort; running from the repo works without installation.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
